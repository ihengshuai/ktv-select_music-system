{
  "name": "ktv-system-v2",
  "private": true,
  "scripts": {
    "test:unit": "vitest run",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "dev:server": "cross-env NODE_ENV=development ONLY_SERVER=Y nest start --watch",
    "build:client": "cross-env NODE_ENV=production vite build",
    "build:server": "cross-env NODE_ENV=production nest build",
    "build": "npm run build:server && npm run build:client",
    "start": "cross-env NODE_ENV=production node dist/server/main.js",
    "lint": "pnpm lint:js && pnpm lint:style",
    "lint:js": "eslint --cache --cache-location 'node_modules/.cache/.cache_eslint' --max-warnings 5  \"client/**/*.{vue,ts,tsx}\" \"src/**/*.ts\" --fix",
    "lint:style": "stylelint 'client/**/*.{less,css,vue,tsx}' --fix",
    "typeorm": "nest build && NODE_ENV=development typeorm-ts-node-esm -d ./dist/server/config/db.config.js",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:generate": "npm run typeorm migration:generate",
    "migration:revert": "npm run typeorm -- migration:revert",
    "postinstall": "husky install"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@hengshuai/helper": "^0.2.6",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^10.0.1",
    "ali-oss": "^6.23.0",
    "ant-design-vue": "^4.0.8",
    "axios": "^1.6.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "co-body": "^6.1.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cross-env": "^10.0.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "echarts": "^5.4.3",
    "ejs": "^3.1.9",
    "express": "^4.19.2",
    "express-static-gzip": "^2.1.7",
    "joi": "^17.9.2",
    "md5": "^2.3.0",
    "mysql2": "^3.7.0",
    "nanoid": "3",
    "nestjs-i18n": "^10.2.6",
    "path-to-regexp": "^6.2.1",
    "pg": "^8.11.1",
    "pinia": "^2.1.7",
    "qs": "^6.11.2",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "svg-captcha": "^1.4.0",
    "typeorm": "^0.3.19",
    "vue": "^3.3.8",
    "vue-i18n": "9",
    "vue-router": "^4.2.5",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.25.7",
    "@babel/plugin-transform-class-properties": "^7.25.7",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.6.13",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.17",
    "@types/md5": "^2.3.5",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.3.1",
    "@types/qs": "^6.9.11",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "dotenv": "^16.3.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^8.0.3",
    "husky": "^8.0.3",
    "jsdom": "^24.1.0",
    "less": "^3.0.0",
    "less-loader": "^8.0.0",
    "postcss-html": "^1.5.0",
    "postcss-less": "^6.0.0",
    "prettier": "^2.4.1",
    "source-map-support": "^0.5.21",
    "stylelint": "^15.9.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recess-order": "^4.2.0",
    "stylelint-config-standard": "^33.0.0",
    "stylelint-config-standard-less": "^1.0.0",
    "stylelint-prettier": "^3.0.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "unocss": "^0.60.3",
    "vite": "^5.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^1.6.0",
    "vue-eslint-parser": "^9.3.2",
    "vue-tsc": "^1.8.22"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
