##### client #####
## 接口域名(后端单独部署时设置此处)
VITE_API_DOMAIN=
VITE_TIMEOUT=60000
VITE_BASE_URL=/



##### 公共 #####
## 应用标题
APP_TITLE=KTV点歌系统
## 支持的语言
LANGUAGES=zh,en
## 默认语言
DEFAULT_LANGUAGE=zh
## cookie域名 .domain.com
COOKIE_DOMAIN=localhost
## 语言cookie名
COOKIE_LANG_KEY=__lang
## 应用唯一标识
APP_ID=ktv-system-v2
## 环境
NODE_ENV=development



##### server #####
## 服务器端口
PORT=10037
# HMR 端口
HMR_PORT=12063
## 接口前缀
API_PREFIX=/api
## token cookie name
TOKEN_COOKIE=__ut
## TOKEN密钥
TOKEN_SECRET=<YOUR_TOKEN_SECRET>
## TTL 限制
TTL_TIME=1000
TTL_LIMIT=20
## 是否忽略签名 true/false
SIGNATURE_IGNORE=



##### 数据库配置 #####
DB_HOST=localhost
DB_PORT=3328
DB_NAME=test_db
DB_USER=root
DB_PWD=123456


# 本地文件上传路径
FILE_UPLOAD_PATH=./.upload

# https://help.aliyun.com/zh/oss/developer-reference/node-js-1/
##### OSS(Aliyun) #####
OSS_KEY=
OSS_SECRET=
OSS_REGION=
OSS_BUCKET=
OSS_DOMAIN=



##### 打包配置 #####
## 客户端打包目录(生产环境)
CLIENT_OUTDIR=dist/client
## 是否开启打包分析
BUNDLE_ANALYZER=false
## SSL证书(设置证书路径，设置后开启HTTPS)
SSL_CERTIFICATE_KEY=/Users/certificates/domain.cc.key
SSL_CERTIFICATE=/Users/certificates/domain.cc.crt
