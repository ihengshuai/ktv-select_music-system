{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "./tsconfig.build.json",
    "builder":"swc",
    "assets": [
      { "include": "i18n/**/*", "watchAssets": false },
      { "include": "views/**/*", "watchAssets": true }
    ]
  }
}
